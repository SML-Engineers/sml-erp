# Copy to .env for local development (`make up` does this automatically).
# These values are for a developer's own machine only. The test and production servers
# get their own, randomly generated values, which are never committed to the repository.

APP_VERSION=0.1.0
DJANGO_SECRET_KEY=dev-only-insecure-key-change-on-every-server
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Encrypts secrets stored in the database (authenticator app secrets). Dev-only value;
# each server gets its own, generated with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=lJudZUYDwgQgllfUwxfGXFuFMVqDnx_eel1IfPjOlB4=
TOTP_ISSUER=SML ERP (dev)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
USE_X_FORWARDED_FOR=true
LOG_LEVEL=INFO

POSTGRES_DB=sml_erp
POSTGRES_USER=sml
POSTGRES_PASSWORD=sml_dev_password
DATABASE_URL=postgres://sml:sml_dev_password@db:5432/sml_erp

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://storage:8333
S3_ACCESS_KEY=sml-dev
S3_SECRET_KEY=sml-dev-storage-password
S3_BUCKET=sml-erp

# Email. Development prints emails in the backend log; servers set an SMTP account.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SML ERP <no-reply@localhost>
# The address people open the ERP at: links in notification emails start with it.
APP_URL=http://localhost:8080
