# The ERP at https://${DOMAIN}. Written by entrypoint.sh from this template.
server_tokens off;

# Port 80: only the Let's Encrypt check; everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate ${CERT};
    ssl_certificate_key ${KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 25m;  # scanned invoices; the API itself allows 20 MB

    # Look the backend up again on every request (Docker's own DNS), so an update that
    # recreates only the backend is found without restarting this web server.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:8000;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The API (Django). The client's address is set here, never taken from the request,
    # so the login history and audit log record the real address.
    location /api/ {
        include /etc/nginx/conf.d/security-headers.inc;
        proxy_pass $backend;
        proxy_hide_header X-Frame-Options;          # set once, above, for every response
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # Built files have their content hash in the name: cache them for a year.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The React app: every other path is a page of the app.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        root /usr/share/nginx/html;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
